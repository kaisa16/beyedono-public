<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Beyedono" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/deep_green</item>
        <item name="android:navigationBarColor">@color/off_white</item>
    </style>

    <!-- Тема для системного Splash Screen -->
    <style name="Theme.Beyedono.Splash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/deep_green</item>
    <!-- Вот эта строка делает фон вокруг иконки прозрачным -->
    <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
	<item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_padded</item>
    <item name="postSplashScreenTheme">@style/Theme.Beyedono</item>
</style>
</resources>